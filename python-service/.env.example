# ===== AI 电商智能客服 Python 服务配置模板 =====
# 使用方式：复制到【项目根目录】并命名为 .env 后按需修改（.env 不纳入版本管理）
# 重要：配置按启动时的工作目录读取，服务必须从项目根目录启动，
#       因此 .env 必须放在项目根目录，放在 python-service 下不会被读取。

# ---- Java 数据服务 ----
JAVA_BASE_URL=http://127.0.0.1:8080
# 内部数据接口独立端口（与 start-java.bat 的 INTERNAL_PORT 一致）
JAVA_INTERNAL_BASE_URL=http://127.0.0.1:8081
# 必须与 Java 侧 INTERNAL_TOKEN 完全一致；无默认值
INTERNAL_TOKEN=
ORDER_DAYS=10

# ---- 会话记忆 ----
# memory：进程内（重启丢失）；redis：生产推荐
MEMORY_BACKEND=memory
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_CONNECT_TIMEOUT=1.0
REDIS_SOCKET_TIMEOUT=1.0
SESSION_TTL_SECONDS=1800

# ---- 知识库（相对项目根目录的路径）----
KNOWLEDGE_FAQ_PATH=./data/knowledge/faq
KNOWLEDGE_PRODUCT_PATH=./data/knowledge/product
KNOWLEDGE_BANNED_PATH=./data/knowledge/banned
HOT_RELOAD_SECONDS=60

# ---- 向量库与 Embedding ----
VECTOR_STORE=memory
EMBEDDING_PROVIDER=hash
RAG_TOP_K=5
RAG_MIN_SCORE=0.3

# ---- 大模型（OpenAI 兼容接口）----
LLM_MOCK=true
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat
TEMPERATURE=0.3

# ---- 回答长度与分段 ----
MAX_ANSWER_CHARS=200
MAX_SEGMENTS=5
SEGMENT_MODE=auto

# ---- 上下文压缩 ----
COMPRESS_THRESHOLD=30
COMPRESS_KEEP_ROUNDS=6
COMPRESS_SUMMARY_MAX=500

# ---- 审计日志 ----
AUDIT_LOG_PATH=./logs/audit.log
AUDIT_LOG_MAX_BYTES=10485760
AUDIT_LOG_BACKUP_COUNT=5
